<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.github.tom2208</groupId>
	<artifactId>chestcleaner</artifactId>
	<version>2.4.5-awepeeps.3</version>

	<packaging>jar</packaging>

	<name>ChestCleaner</name>
	<description>A plugin for minecraft spigot servers. It can sort inventories and refills items into the hotbar.</description>
	<url>https://github.com/tom2208/ChestCleaner</url>

	<properties>
		<version.properties>2-4-5-awepeeps-3</version.properties>
		<project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<repositories>
		<!-- This adds the Paper Maven repository to the build -->
		<repository>
			<id>papermc</id>
			<url>https://repo.papermc.io/repository/maven-public/</url>
		</repository>
	</repositories>

	<licenses>
		<license>
			<name>GPLv3</name>
			<url>http://www.gnu.org/copyleft/gpl.html</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Tom Hauschild</name>
			<email>tom-hauschild@outlook.de</email>
			<organizationUrl>https://github.com/tom2208</organizationUrl>
		</developer>
	</developers>

	<dependencies>
		<!--This adds the Paper API artifact to the build. We compile against the
		    server the plugin actually runs on (Paper 26.3, Java 25). -->
		<dependency>
			<groupId>io.papermc.paper</groupId>
			<artifactId>paper-api</artifactId>
			<version>26.3.build.175-stable</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.12.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<version>5.18.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.12.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<defaultGoal>clean install</defaultGoal>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>tests</testSourceDirectory>
		<plugins>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<outputTimestamp>${project.build.outputTimestamp}</outputTimestamp>
					<!-- Do not embed META-INF/maven/**/pom.properties: its line
					     endings are platform dependent and would make the jar
					     differ between the Windows and Linux builds. -->
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<!-- Paper 26.3 API jars are Java 25 class files (major 69). -->
					<release>25</release>
				</configuration>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>./</directory>
				<includes>
					<include>plugin.yml</include>
					<include>ChestCleaner_${version.properties}_de_DE.properties</include>
					<include>ChestCleaner_${version.properties}_en_GB.properties</include>
					<include>ChestCleaner_${version.properties}_ja_JP.properties</include>
					<include>ChestCleaner_${version.properties}_zh_CN.properties</include>
					<include>config.yml</include>
				</includes>
			</resource>
		</resources>
	</build>

</project>
